@page "/Game"
@using MilesHighPoker.GameLogic
@using MilesHighPoker.Models
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Miles High Poker! Game Page</PageTitle>

<div class="app-container">
    <h1 class="text-center p-1">Miles High Poker</h1>

    @if (!String.IsNullOrWhiteSpace(StatusMessage))
    {
        <p class="text-center game-status mb-2">@StatusMessage</p>
    }

    <div id="gameplay-div" class="container">
        <div id="community-card-div">
            @for (int i = 0; i < uiState.CommunityCards.Length; i++)
            {
                <div id="community-card-@i"
                     class="community-card-slot"
                     data-slot="@i"
                     @key="i">
                    @if (uiState.CommunityCards[i] is not null)
                    {
                        Card card = uiState.CommunityCards[i]!;
                        <img class="card-face-image"
                             src="@ToCardFile(card)"
                             alt="@($"{card.Rank} of {card.Suit}")" />
                    }
                </div>
            }
        </div>

        <div id="pot">
            <p class="text-center m-0">Pot: $@uiState.Pot</p>
            @if (uiState.CurrentBet > 0)
            {
                <p class="text-center m-0 text-muted small">Current Bet: $@uiState.CurrentBet</p>
            }
        </div>

        @{
            UiSeatState? topLeftSeat = SeatSlots[0];
            UiSeatState? topRightSeat = SeatSlots[1];
            UiSeatState? bottomLeftSeat = SeatSlots[2];
            UiSeatState? bottomRightSeat = SeatSlots[3];
            UiSeatState? currentSeat = SeatSlots[4];
            const int HOLE_CARD_COUNT = 2;
            string cardBackPath = "/images/cards/card_back.png";
        }

        <div id="top-left-player" class="player-seat @(topLeftSeat?.Seat == uiState.DealerSeat ? "dealer" : "") @(topLeftSeat?.Seat == uiState.CurrentTurnSeat ? "current-turn" : "") @(topLeftSeat?.Folded ?? false ? "folded" : "")">
            @if (topLeftSeat is not null)
            {
                @if (uiState.IsHandRunning)
                {
                    <div class="player-cards">
                        @for (int i = 0; i < HOLE_CARD_COUNT; i++)
                        {
                            <div id="top-left-player-card-@i" class="player-card-slot">
                                @if (topLeftSeat.Seat == currentSeat?.Seat)
                                {
                                    // local player's seat: show face-up local cards
                                    if (uiState.LocalHoleCards.Length > i && uiState.LocalHoleCards[i] is not null)
                                    {
                                        Card card = uiState.LocalHoleCards[i]!;
                                        <img class="card-face-image"
                                             src="@ToCardFile(card)"
                                             alt="@($"{card.Rank} of {card.Suit}")" />
                                    }
                                }
                                else
                                {
                                    // other players: show card back
                                    <img class="card-back-image" src="@cardBackPath" alt="card back" />
                                }
                            </div>
                        }
                    </div>
                }

                <div id="top-left-player-name" class="player-name">
                    @topLeftSeat.Name
                    @if (topLeftSeat.Seat == uiState.DealerSeat)
                    {
                        <span class="dealer-badge">D</span>
                    }
                </div>
                <div id="top-left-player-money" class="player-money">$@topLeftSeat.Chips</div>
                @if (topLeftSeat.Bet > 0)
                {
                    <div class="player-bet">Bet: $@topLeftSeat.Bet</div>
                }
                @if (topLeftSeat.IsAllIn)
                {
                    <div class="player-status all-in-text">ALL IN</div>
                }
            }
        </div>

        <div id="top-right-player" class="player-seat @(topRightSeat?.Seat == uiState.DealerSeat ? "dealer" : "") @(topRightSeat?.Seat == uiState.CurrentTurnSeat ? "current-turn" : "") @(topRightSeat?.Folded ?? false ? "folded" : "")">
            @if (topRightSeat is not null)
            {
                @if (uiState.IsHandRunning)
                {
                    <div class="player-cards">
                        @for (int i = 0; i < HOLE_CARD_COUNT; i++)
                        {
                            <div id="top-right-player-card-@i" class="player-card-slot">
                                @if (topRightSeat.Seat == currentSeat?.Seat)
                                {
                                    if (uiState.LocalHoleCards.Length > i && uiState.LocalHoleCards[i] is not null)
                                    {
                                        Card card = uiState.LocalHoleCards[i]!;
                                        <img class="card-face-image"
                                             src="@ToCardFile(card)"
                                             alt="@($"{card.Rank} of {card.Suit}")" />
                                    }
                                }
                                else
                                {
                                    <img class="card-back-image" src="@cardBackPath" alt="card back" />
                                }
                            </div>
                        }
                    </div>
                }

                <div id="top-right-player-name" class="player-name">
                    @topRightSeat.Name
                    @if (topRightSeat.Seat == uiState.DealerSeat)
                    {
                        <span class="dealer-badge">D</span>
                    }
                </div>
                <div id="top-right-player-money" class="player-money">$@topRightSeat.Chips</div>
                @if (topRightSeat.Bet > 0)
                {
                    <div class="player-bet">Bet: $@topRightSeat.Bet</div>
                }
                @if (topRightSeat.IsAllIn)
                {
                    <div class="player-status all-in-text">ALL IN</div>
                }
            }
        </div>

        <div id="bottom-left-player" class="player-seat @(bottomLeftSeat?.Seat == uiState.DealerSeat ? "dealer" : "") @(bottomLeftSeat?.Seat == uiState.CurrentTurnSeat ? "current-turn" : "") @(bottomLeftSeat?.Folded ?? false ? "folded" : "")">
            @if (bottomLeftSeat is not null)
            {
                @if (uiState.IsHandRunning)
                {
                    <div class="player-cards">
                        @for (int i = 0; i < HOLE_CARD_COUNT; i++)
                        {
                            <div id="bottom-left-player-card-@i" class="player-card-slot">
                                @if (bottomLeftSeat.Seat == currentSeat?.Seat)
                                {
                                    if (uiState.LocalHoleCards.Length > i && uiState.LocalHoleCards[i] is not null)
                                    {
                                        Card card = uiState.LocalHoleCards[i]!;
                                        <img class="card-face-image"
                                             src="@ToCardFile(card)"
                                             alt="@($"{card.Rank} of {card.Suit}")" />
                                    }
                                }
                                else
                                {
                                    <img class="card-back-image" src="@cardBackPath" alt="card back" />
                                }
                            </div>
                        }
                    </div>
                }

                <div id="bottom-left-player-name" class="player-name">
                    @bottomLeftSeat.Name
                    @if (bottomLeftSeat.Seat == uiState.DealerSeat)
                    {
                        <span class="dealer-badge">D</span>
                    }
                </div>
                <div id="bottom-left-player-money" class="player-money">$@bottomLeftSeat.Chips</div>
                @if (bottomLeftSeat.Bet > 0)
                {
                    <div class="player-bet">Bet: $@bottomLeftSeat.Bet</div>
                }
                @if (bottomLeftSeat.IsAllIn)
                {
                    <div class="player-status all-in-text">ALL IN</div>
                }
            }
        </div>

        <div id="bottom-right-player" class="player-seat @(bottomRightSeat?.Seat == uiState.DealerSeat ? "dealer" : "") @(bottomRightSeat?.Seat == uiState.CurrentTurnSeat ? "current-turn" : "") @(bottomRightSeat?.Folded ?? false ? "folded" : "")">
            @if (bottomRightSeat is not null)
            {
                @if (uiState.IsHandRunning)
                {
                    <div class="player-cards">
                        @for (int i = 0; i < HOLE_CARD_COUNT; i++)
                        {
                            <div id="bottom-right-player-card-@i" class="player-card-slot">
                                @if (bottomRightSeat.Seat == currentSeat?.Seat)
                                {
                                    if (uiState.LocalHoleCards.Length > i && uiState.LocalHoleCards[i] is not null)
                                    {
                                        Card card = uiState.LocalHoleCards[i]!;
                                        <img class="card-face-image"
                                             src="@ToCardFile(card)"
                                             alt="@($"{card.Rank} of {card.Suit}")" />
                                    }
                                }
                                else
                                {
                                    <img class="card-back-image" src="@cardBackPath" alt="card back" />
                                }
                            </div>
                        }
                    </div>
                }

                <div id="bottom-right-player-name" class="player-name">
                    @bottomRightSeat.Name
                    @if (bottomRightSeat.Seat == uiState.DealerSeat)
                    {
                        <span class="dealer-badge">D</span>
                    }
                </div>
                <div id="bottom-right-player-money" class="player-money">$@bottomRightSeat.Chips</div>
                @if (bottomRightSeat.Bet > 0)
                {
                    <div class="player-bet">Bet: $@bottomRightSeat.Bet</div>
                }
                @if (bottomRightSeat.IsAllIn)
                {
                    <div class="player-status all-in-text">ALL IN</div>
                }
            }
        </div>

        <div id="current-player-div" class="player-seat current-player-seat @(currentSeat?.Seat == uiState.DealerSeat ? "dealer" : "") @(currentSeat?.Folded ?? false ? "folded" : "")">
            @if (currentSeat is not null)
            {
                @if (uiState.IsHandRunning)
                {
                    <div class="player-cards">
                        @for (int i = 0; i < uiState.LocalHoleCards.Length; i++)
                        {
                            <div id="current-player-card-@i" class="player-card-slot">
                                @if (uiState.LocalHoleCards[i] is not null)
                                {
                                    Card card = uiState.LocalHoleCards[i]!;
                                    <img class="card-face-image"
                                         src="@ToCardFile(card)"
                                         alt="@($"{card.Rank} of {card.Suit}")" />
                                }
                            </div>
                        }
                    </div>
                }

                <div id="current-player-name" class="player-name">
                    @currentSeat.Name
                    @if (currentSeat.Seat == uiState.DealerSeat)
                    {
                        <span class="dealer-badge">D</span>
                    }
                    (YOU)
                </div>
                <div id="current-player-money" class="player-money">$@currentSeat.Chips</div>
                @if (currentSeat.Bet > 0)
                {
                    <div class="player-bet">Bet: $@currentSeat.Bet</div>
                }
                @if (currentSeat.IsAllIn)
                {
                    <div class="player-status all-in-text">ALL IN</div>
                }
            }
        </div>

        <div id="current-player-actions" class="text-center">
            @if (CanStartHand)
            {
                <button class="btn btn-success" @onclick="StartHandAsync" disabled="@isStartingHand">
                    <span class="action-label">Deal</span>
                </button>
            }
            @if (IsLocalPlayerTurn)
            {
                <button class="btn btn-danger" @onclick="FoldAsync">
                    <span class="action-label">Fold</span>
                </button>
                <button class="btn btn-warning" @onclick="CheckAsync">
                    <span class="action-label">Check</span>
                </button>
                <button class="btn btn-info" @onclick="CallAsync">
                    <span class="action-label">Call</span>
                </button>
                <div class="d-inline-flex align-items-center" style="gap:.4rem; min-width:220px;">
                    <input type="number"
                           class="form-control form-control-sm"
                           style="width:120px;"
                           @bind="raiseInput"
                           min="@MinTotalBet"
                           max="@MaxTotalBet"
                           placeholder="@($"Min: {MinTotalBet}")" />

                    <button class="btn btn-primary"
                            @onclick="RaiseClickedAsync">
                        <span class="action-label">Raise</span>
                    </button>
                </div>

                @if (uiState.MinimumRaise > 0)
                {
                    <div class="small text-muted mt-1">
                        Min raise increment: $@uiState.MinimumRaise · Min total bet: $@MinTotalBet · Max (all-in): $@MaxTotalBet
                    </div>
                }
            }
            else if (uiState.IsHandRunning && currentSeat?.Folded == false && currentSeat?.IsAllIn == false)
            {
                <p class="text-muted">Waiting for your turn...</p>
            }
        </div>
    </div>
</div>

<div id="poker-instructions-div" class="container mt-4">
    <h2 class="text-center fw-bolder">How to Play</h2>

    <section class="instruction-section">
        <h3>Game Flow</h3>
        <ul>
            <li>Each player receives 2 private cards ("hole cards").</li>
            <li>Round starts with a betting phase.</li>
            <li>The dealer reveals 3 community cards (the flop), followed by another betting phase.</li>
            <li>The dealer reveals a 4th community card (the turn), followed by another betting phase.</li>
            <li>The dealer reveals a 5th community card (the river), followed by the final betting phase.</li>
            <li>Remaining players go to showdown.</li>
        </ul>
    </section>

    <section class="instruction-section">
        <h3>Betting</h3>
        <ul>
            <li>On your turn, you can usually Fold, Call, or Raise.</li>
            <li><strong>Fold:</strong> Exit the current hand and forfeit chips already committed.</li>
            <li><strong>Call:</strong> Match the current highest bet.</li>
            <li><strong>Raise:</strong> Increase the current highest bet for other players to match.</li>
            <li>Each Raise must be at least the size of the last full Raise.</li>
            <li>Betting round ends when all active players have matched the current bet (or folded).</li>
        </ul>
    </section>

    <section class="instruction-section">
        <h3>Winner</h3>
        <ul>
            <li>Use any 5 cards from your 2 hole cards + 5 community cards.</li>
            <li>Best 5-card poker hand wins the pot.</li>
            <li>If all other players fold, the last active player wins immediately.</li>
            <li>If two or more players tie exactly, the pot is split evenly.</li>
        </ul>
    </section>

    <section class="instruction-section">
        <h3>Special Cases</h3>
        <ul>
            <li><strong>All-in:</strong> A player can bet all remaining chips and can only win the amount they are eligible for.</li>
            <li><strong>Side pots:</strong> If players are all-in for different amounts, extra chips are placed in side pots.</li>
            <li><strong>Disconnected player:</strong> The timer running out will result in a Fold.</li>
            <li><strong>Insufficient chips to call:</strong> Player can go all-in for less than a full call amount.</li>
            <li><strong>Split pot with odd chip:</strong> Extra chip goes to the tied winner first clockwise from the dealer.</li>
        </ul>
    </section>

    <section class="instruction-section">
        <h3>Hand Rankings (Best to Worst)</h3>
        <ol>
            <li><strong>Straight Flush</strong>: Five cards in sequence, all of the same suit.</li>
            <li><strong>Four of a Kind</strong>: Four cards of the same rank.</li>
            <li><strong>Full House</strong>: Three cards of one rank, plus two cards of another.</li>
            <li><strong>Flush</strong>: Any five cards of the same suit, not in sequence.</li>
            <li><strong>Straight</strong>: Five cards in sequence, but not all of the same suit.</li>
            <li><strong>Three of a Kind</strong>: Three cards of the same rank.</li>
            <li><strong>Two Pair</strong>: Two different pairs.</li>
            <li><strong>Pair</strong>: Two cards of the same rank.</li>
            <li><strong>High Card</strong>: If no one has any of the above, the highest card wins.</li>
        </ol>
    </section>
</div>